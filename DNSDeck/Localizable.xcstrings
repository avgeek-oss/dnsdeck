    "Create an MCP request in Postman, choose STDIO, then paste this JSON configuration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine MCP-Anfrage in Postman, wählen Sie STDIO und fügen Sie dann diese JSON-Konfiguration ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an MCP request in Postman, choose STDIO, then paste this JSON configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree una solicitud MCP en Postman, elija STDIO y luego pegue esta configuración de JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une requête MCP dans Postman, choisissez STDIO, puis collez cette configuration JSON."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Postman में एक MCP अनुरोध बनाएं, STDIO चुनें, फिर इस JSON कॉन्फ़िगरेशन को पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat permintaan MCP di Postman, pilih STDIO, lalu tempel konfigurasi JSON ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Postman で MCP リクエストを作成し、STDIO を選択して、この JSON 構成を貼り付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
