    "OVHcloud accepts automatic TTL as 0; explicit TTLs must be at least 60 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud akzeptiert automatische TTL als 0; Explizite TTLs müssen mindestens 60 Sekunden lang sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud acepta el TTL automático como 0; Los TTL explícitos deben tener al menos 60 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud accepte le TTL automatique à 0 ; les durées de vie explicites doivent durer au moins 60 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud स्वचालित TTL को 0 के रूप में स्वीकार करता है; स्पष्ट टीटीएल कम से कम 60 सेकंड का होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud menerima TTL otomatis sebagai 0; TTL eksplisit harus berdurasi minimal 60 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud は自動 TTL を 0 として受け入れます。明示的な TTL は少なくとも 60 秒である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud는 자동 TTL을 0으로 허용합니다. 명시적 TTL은 60초 이상이어야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud akceptuje automatyczne TTL jako 0; Wyraźne TTL muszą wynosić co najmniej 60 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A OVHcloud aceita TTL automático como 0; TTLs explícitos devem ter pelo menos 60 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud, otomatik TTL'yi 0 olarak kabul eder; açık TTL'ler en az 60 saniye olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud приймає автоматичний TTL як 0; явні TTL мають бути не менше 60 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud chấp nhận TTL tự động là 0; TTL rõ ràng phải dài ít nhất 60 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud 接受自动 TTL 为 0；显式 TTL 必须至少为 60 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OVHcloud 接受自動 TTL 為 0；明確 TTL 必須至少為 60 秒。"
          }
        }
      }
    },
    "Once you connect a provider, select a zone to view and manage DNS records.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Sie einen Anbieter verbunden haben, wählen Sie eine Zone aus, um DNS-Einträge anzuzeigen und zu verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que conecte un proveedor, seleccione una zona para ver y administrar registros DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois que vous avez connecté un fournisseur, sélectionnez une zone pour afficher et gérer les enregistrements DNS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार जब आप किसी प्रदाता से जुड़ जाते हैं, तो DNS रिकॉर्ड देखने और प्रबंधित करने के लिए एक क्षेत्र चुनें।"
          }
        },
        "id": {
          "stringUnit": {
