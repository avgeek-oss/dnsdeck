    "Replace a literal substring across all loaded records in this zone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzen Sie eine literale Teilzeichenfolge über alle geladenen Datensätze in dieser Zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplace una subcadena literal en todos los registros cargados en esta zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez une sous-chaîne littérale dans tous les enregistrements chargés dans cette zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्षेत्र में सभी लोड किए गए रिकॉर्ड में एक शाब्दिक सबस्ट्रिंग बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti substring literal di semua catatan yang dimuat di zona ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゾーンにロードされたすべてのレコードのリテラル部分文字列を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역에 로드된 모든 레코드에서 리터럴 하위 문자열을 바꿉니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp dosłowny podciąg we wszystkich załadowanych rekordach w tej strefie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua uma substring literal em todos os registros carregados nesta zona."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölgedeki tüm yüklü kayıtlar arasında değişmez bir alt dizeyi değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замініть літеральний підрядок у всіх завантажених записах у цій зоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế một chuỗi con bằng chữ trên tất cả các bản ghi được tải trong vùng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换该区域中所有已加载记录的文字子字符串。"
          }
        },
        "zh-Hant": {
