    "deSEC caps TTLs at one day and enforces the minimum returned for each domain. DNSDeck applies that domain-specific minimum when writing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC begrenzt die TTLs auf einen Tag und erzwingt den für jede Domain zurückgegebenen Mindestwert. DNSDeck wendet beim Schreiben dieses domänenspezifische Minimum an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC limita los TTL a un día y exige el mínimo devuelto para cada dominio. DNSDeck aplica ese mínimo específico del dominio al escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC limite les TTL à un jour et applique le minimum renvoyé pour chaque domaine. DNSDeck applique ce minimum spécifique au domaine lors de l'écriture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डीएसईसी एक दिन में टीटीएल को सीमित करता है और प्रत्येक डोमेन के लिए न्यूनतम रिटर्न लागू करता है। लिखते समय DNSDeck उस डोमेन-विशिष्ट न्यूनतम को लागू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC membatasi TTL pada satu hari dan menerapkan jumlah minimum yang dikembalikan untuk setiap domain. DNSDeck menerapkan minimum khusus domain tersebut saat menulis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC は 1 日の TTL に上限を設け、ドメインごとに返される最小値を強制します。 DNSDeck は、書き込み時にドメイン固有の最小値を適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC는 TTL을 하루로 제한하고 각 도메인에 대해 반환되는 최소값을 적용합니다. DNSDeck은 쓰기 시 해당 도메인별 최소값을 적용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC ogranicza TTL do jednego dnia i wymusza minimalną zwrot dla każdej domeny. DNSDeck podczas zapisywania stosuje minimum specyficzne dla domeny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deSEC limita os TTLs em um dia e impõe o mínimo retornado para cada domínio. O DNSDeck aplica esse mínimo específico do domínio ao escrever."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC, TTL'leri bir günde sınırlandırır ve her alan adı için döndürülen minimum tutarı zorunlu kılar. DNSDeck, yazarken etki alanına özgü minimum değeri uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC обмежує TTL на один день і забезпечує мінімальне повернення для кожного домену. DNSDeck застосовує цей мінімум для домену під час запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC giới hạn TTL trong một ngày và thực thi mức trả về tối thiểu cho mỗi miền. DNSDeck áp dụng mức tối thiểu dành riêng cho từng miền khi ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC 将 TTL 限制为某一天，并强制执行每个域返回的最小值。 DNSDeck 在写入时应用特定于域的最低限度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "deSEC 將 TTL 限制為某一天，並強制執行每個域回傳的最小值。 DNSDeck 在寫入時會套用特定於網域的最低限度。"
          }
        }
      }
    },
