    "Delete \"%@\" and all of its DNS records from %@? This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und alle seine DNS-Einträge aus %2$@ löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Delete \"%1$@\" and all of its DNS records from %2$@? This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar \"%1$@\" y todos sus registros DNS de %2$@? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » et tous ses enregistrements DNS de %2$@ ? Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ से \"%1$@\" और इसके सभी DNS रिकॉर्ड हटाएं? इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus \"%1$@\" dan semua data DNS-nya dari %2$@? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」とそのすべての DNS レコードを %2$@ から削除しますか?この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@' 및 모든 해당 DNS 레코드를 %2$@에서 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć „%1$@” i wszystkie jego rekordy DNS z %2$@? Tej akcji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir \"%1$@\" e todos os seus registros DNS de %2$@? Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" ve tüm DNS kayıtları %2$@'den silinsin mi? Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити \"%1$@\" і всі його записи DNS із %2$@? Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa \"%1$@\" và tất cả bản ghi DNS của nó khỏi %2$@? Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %2$@ 中删除“%1$@”及其所有 DNS 记录吗？此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 %2$@ 中刪除「%1$@」及其所有 DNS 記錄嗎？此操作無法撤銷。"
          }
        }
      }
    },
