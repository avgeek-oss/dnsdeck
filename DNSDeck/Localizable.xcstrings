    "Changing registrar nameservers can interrupt DNS until delegation propagates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern der Nameserver des Registrars kann DNS unterbrechen, bis die Delegierung erfolgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar los servidores de nombres del registrador puede interrumpir el DNS hasta que se propague la delegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification des serveurs de noms du bureau d'enregistrement peut interrompre le DNS jusqu'à ce que la délégation se propage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रजिस्ट्रार नेमसर्वर बदलने से डेलिगेशन प्रसारित होने तक डीएनएस बाधित हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah server nama registrar dapat mengganggu DNS hingga delegasi disebarkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レジストラのネームサーバーを変更すると、委任が伝播するまで DNS が中断される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록자 이름 서버를 변경하면 위임이 전파될 때까지 DNS가 중단될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana serwerów nazw rejestratora może przerwać działanie systemu DNS do czasu propagacji delegowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração dos servidores de nomes do registrador pode interromper o DNS até que a delegação se propague."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt şirketi ad sunucularının değiştirilmesi, yetkilendirme yayılana kadar DNS'yi kesintiye uğratabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна серверів імен реєстратора може призвести до переривання DNS, доки не пошириться делегування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc thay đổi máy chủ tên của công ty đăng ký có thể làm gián đoạn DNS cho đến khi việc ủy quyền được phổ biến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改注册商名称服务器可能会中断 DNS，直到委托传播为止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改註冊商名稱伺服器可能會中斷 DNS，直到委託傳播為止。"
          }
        }
      }
    },
