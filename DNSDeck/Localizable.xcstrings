    "OCI accepts whole-second RRset TTLs; Oracle recommends values of at least 30 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI akzeptiert RRset-TTLs von ganzer Sekunde; Oracle empfiehlt Werte von mindestens 30 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI acepta TTL de RRset de segundos completos; Oracle recomienda valores de al menos 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI accepte les TTL RRset d'une seconde entière ; Oracle recommande des valeurs d'au moins 30 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओसीआई पूरे दूसरे आरआरसेट टीटीएल को स्वीकार करता है; Oracle कम से कम 30 सेकंड के मान की अनुशंसा करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI menerima TTL RRset seluruh detik; Oracle merekomendasikan nilai minimal 30 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OCIは整数秒のRRset TTLを受け入れます。 Oracle では、少なくとも 30 秒の値を推奨します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI는 전체 초 RRset TTL을 허용합니다. Oracle에서는 30초 이상의 값을 권장합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI akceptuje całodobowe wartości TTL RRset; Oracle zaleca wartości co najmniej 30 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI aceita TTLs RRset de segundos inteiros; A Oracle recomenda valores de pelo menos 30 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI tam saniyelik RRset TTL'leri kabul eder; Oracle en az 30 saniyelik değerleri önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI приймає цілі секунди RRset TTL; Oracle рекомендує значення не менше 30 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI chấp nhận TTL tập bản ghi toàn bộ giây; Oracle khuyến nghị các giá trị ít nhất là 30 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI 接受整秒 RRset TTL； Oracle 建议该值至少为 30 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI 接受整秒 RRset TTL； Oracle 建議該值至少為 30 秒。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay"
