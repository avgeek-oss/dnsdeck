    "You have unsaved changes. Are you sure you want to discard them?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben nicht gespeicherte Änderungen. Sind Sie sicher, dass Sie sie verwerfen möchten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes cambios sin guardar. ¿Estás seguro de que quieres descartarlos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des modifications non enregistrées. Êtes-vous sûr de vouloir les supprimer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास सहेजे नहीं गए परिवर्तन हैं. क्या आप वाकई उन्हें त्यागना चाहते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memiliki perubahan yang belum disimpan. Apakah Anda yakin ingin membuangnya?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の変更があります。本当に破棄してもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 변경사항이 있습니다. 정말로 삭제하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz niezapisane zmiany. Czy na pewno chcesz je odrzucić?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem alterações não salvas. Tem certeza de que deseja descartá-los?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş değişiklikleriniz var. Bunları silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас є незбережені зміни. Ви впевнені, що бажаєте їх відкинути?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có những thay đổi chưa được lưu. Bạn có chắc chắn muốn loại bỏ chúng không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您有未保存的更改。您确定要丢弃它们吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您有未儲存的變更。您確定要丟棄它們嗎？"
          }
        }
      }
    },
