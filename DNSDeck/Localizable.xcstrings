    "Are you sure you want to delete \"%@\"? This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie „%@“ löschen möchten? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea eliminar \"%@\"? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etes-vous sûr de vouloir supprimer « %@ » ? Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई \"%@\" को हटाना चाहते हैं? इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus \"%@\"? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除してもよろしいですか?この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 \"%@\"을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć „%@”? Tej akcji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir \"%@\"? Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" öğesini silmek istediğinizden emin misiniz? Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити \"%@\"? Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa \"%@\" không? Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要删除“%@”吗？此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要刪除“%@”嗎？此操作無法撤銷。"
          }
        }
      }
    },
    "Authenticate with your biometrics to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizieren Sie sich mit Ihren biometrischen Daten, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentícate con tus datos biométricos para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous avec vos données biométriques pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए अपने बायोमेट्रिक्स से प्रमाणित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otentikasi dengan biometrik Anda untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するには、生体認証で認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 생체 인식으로 인증하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, uwierzytelnij się za pomocą danych biometrycznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentique-se com sua biometria para continuar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için biyometrik bilgilerinizle kimlik doğrulaması yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, пройдіть автентифікацію за допомогою біометричних даних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực bằng sinh trắc học của bạn để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的生物识别信息进行身份验证以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的生物識別資訊進行身份驗證以繼續。"
          }
        }
      }
    },
    "Authenticate with your device password to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizieren Sie sich mit Ihrem Gerätepasswort, um fortzufahren."
          }
