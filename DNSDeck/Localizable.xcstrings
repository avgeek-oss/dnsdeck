    "Spaceship DNS record TTLs must be between 60 and 3600 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die TTLs für DNS-Einträge von Raumschiffen müssen zwischen 60 und 3600 Sekunden liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los TTL del registro DNS de la nave espacial deben estar entre 60 y 3600 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les durées de vie des enregistrements DNS du vaisseau spatial doivent être comprises entre 60 et 3 600 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेसशिप डीएनएस रिकॉर्ड टीटीएल 60 से 3600 सेकंड के बीच होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL rekaman DNS pesawat ruang angkasa harus antara 60 dan 3600 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceship DNS レコードの TTL は 60 ～ 3600 秒である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우주선 DNS 레코드 TTL은 60~3600초 사이여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość TTL rekordu DNS statku kosmicznego musi wynosić od 60 do 3600 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os TTLs do registro DNS da nave espacial devem estar entre 60 e 3.600 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzay gemisi DNS kaydı TTL'leri 60 ila 3600 saniye arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL запису DNS космічного корабля має становити від 60 до 3600 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL của bản ghi DNS tàu vũ trụ phải nằm trong khoảng từ 60 đến 3600 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宇宙飞船 DNS 记录 TTL 必须介于 60 到 3600 秒之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太空船 DNS 記錄 TTL 必須介於 60 到 3600 秒之間。"
          }
        }
      }
    },
