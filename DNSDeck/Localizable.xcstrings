    "Invalid MX record format. Expected 'priority domain' or 'domain'": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges MX-Eintragsformat. Erwartete „Prioritätsdomäne“ oder „Domäne“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de registro MX no válido. 'Dominio prioritario' o 'dominio' esperado"
