    "IBM NS1 Connect applies one non-negative TTL to a record and all of its answers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect wendet eine nicht negative TTL auf einen Datensatz und alle seine Antworten an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect aplica un TTL no negativo a un registro y a todas sus respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect applique une durée de vie non négative à un enregistrement et à toutes ses réponses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 कनेक्ट एक रिकॉर्ड और उसके सभी उत्तरों पर एक गैर-नकारात्मक TTL लागू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect menerapkan satu TTL non-negatif pada catatan dan semua jawabannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect は、1 つの非負の TTL をレコードとそのすべての回答に適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect는 음이 아닌 하나의 TTL을 레코드와 모든 응답에 적용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect stosuje jeden nieujemny czas TTL do rekordu i wszystkich jego odpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O IBM NS1 Connect aplica um TTL não negativo a um registro e a todas as suas respostas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect, bir kayda ve onun tüm yanıtlarına negatif olmayan bir TTL uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect застосовує один невід’ємний TTL до запису та всіх його відповідей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect áp dụng một TTL không âm cho một bản ghi và tất cả các câu trả lời của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect 将一个非负 TTL 应用于记录及其所有答案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IBM NS1 Connect 將一個非負 TTL 應用於記錄及其所有答案。"
          }
        }
      }
    },
