            "value": "Виберіть середовище на бічній панелі, щоб переглянути зони"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một môi trường từ thanh bên để xem các vùng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏中选择一个环境来查看区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從側邊欄中選擇一個環境來查看區域"
          }
        }
      }
    },
    "Choose how dates and times are displayed in the created and modified columns.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, wie Datums- und Uhrzeitangaben in den erstellten und geänderten Spalten angezeigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija cómo se muestran las fechas y horas en las columnas creadas y modificadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la façon dont les dates et les heures sont affichées dans les colonnes créées et modifiées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि निर्मित और संशोधित कॉलम में दिनांक और समय कैसे प्रदर्शित होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bagaimana tanggal dan waktu ditampilkan di kolom yang dibuat dan diubah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成および変更された列に日付と時刻を表示する方法を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 및 수정된 열에 날짜와 시간이 표시되는 방식을 선택합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sposób wyświetlania dat i godzin w tworzonych i modyfikowanych kolumnach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como as datas e horas serão exibidas nas colunas criadas e modificadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan ve değiştirilen sütunlarda tarih ve saatlerin nasıl görüntüleneceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть спосіб відображення дат і часу у створених і змінених стовпцях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cách hiển thị ngày và giờ trong các cột đã tạo và sửa đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日期和时间在创建和修改的列中的显示方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇日期和時間在建立和修改的列中的顯示方式。"
          }
        }
      }
    },
    "Choose the app you want to connect. DNSDeck will show only the setup details for that app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die App aus, die Sie verbinden möchten. DNSDeck zeigt nur die Setup-Details für diese App an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the app you want to connect. DNSDeck will show only the setup details for that app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la aplicación que desea conectar. DNSDeck mostrará solo los detalles de configuración de esa aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'application à laquelle vous souhaitez vous connecter. DNSDeck affichera uniquement les détails de configuration de cette application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ऐप चुनें जिसे आप कनेक्ट करना चाहते हैं. ZXQDNSDEKTERM0000QXZ केवल उस ऐप के लिए सेटअप विवरण दिखाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi yang ingin Anda sambungkan. DNSDeck hanya akan menampilkan detail pengaturan untuk aplikasi itu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続するアプリを選択します。 DNSDeck には、そのアプリのセットアップの詳細のみが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하려는 앱을 선택하세요. DNSDeck는 해당 앱의 설정 세부정보만 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację, z którą chcesz się połączyć. DNSDeck wyświetli tylko szczegóły konfiguracji tej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o aplicativo que você deseja conectar. DNSDeck mostrará apenas os detalhes de configuração desse aplicativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanmak istediğiniz uygulamayı seçin. ZXQDNNSDECKTERM0000QXZ yalnızca söz konusu uygulamanın kurulum ayrıntılarını gösterecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть програму, яку хочете підключити. DNSDeck покаже лише деталі налаштування для цієї програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ứng dụng bạn muốn kết nối. DNSDeck sẽ chỉ hiển thị chi tiết thiết lập cho ứng dụng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您要连接的应用程序。 DNSDeck 将仅显示该应用程序的设置详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇您要連接的應用程式。 DNSDeck 將僅顯示該應用程式的設定詳細資訊。"
          }
        }
      }
    },
