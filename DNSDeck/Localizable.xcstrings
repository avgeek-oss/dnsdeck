    "Name.com Core API records use a minimum TTL of 300 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com Core API-Datensätze verwenden eine Mindest-TTL von 300 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de Name.com Core API utilizan un TTL mínimo de 300 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements de l'API Name.com Core utilisent une durée de vie minimale de 300 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com कोर एपीआई रिकॉर्ड न्यूनतम 300 सेकंड के टीटीएल का उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan API Inti Name.com menggunakan TTL minimum 300 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com コア API レコードは、最小 TTL 300 秒を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com Core API 레코드는 최소 TTL 300초를 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordy API Name.com Core wykorzystują minimalny TTL wynoszący 300 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros da API principal do Name.com usam um TTL mínimo de 300 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com Core API kayıtları minimum 300 saniyelik TTL kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи Name.com Core API використовують мінімум TTL 300 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi API cốt lõi của Name.com sử dụng TTL tối thiểu là 300 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com 核心 API 记录使用的最小 TTL 为 300 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Name.com 核心 API 記錄使用的最小 TTL 為 300 秒。"
          }
        }
      }
    },
    "Namecheap host TTL values must be between 60 and 60000 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die TTL-Werte des Namecheap-Hosts müssen zwischen 60 und 60.000 Sekunden liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores TTL del host de Namecheap deben estar entre 60 y 60000 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs TTL de l’hôte Namecheap doivent être comprises entre 60 et 60 000 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेमचीप होस्ट टीटीएल मान 60 और 60000 सेकंड के बीच होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai TTL host Namecheap harus antara 60 dan 60000 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap ホストの TTL 値は 60 ～ 60000 秒である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap 호스트 TTL 값은 60~60000초 사이여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości TTL hosta Namecheap muszą mieścić się w przedziale od 60 do 60 000 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores TTL do host Namecheap devem estar entre 60 e 60.000 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap ana bilgisayar TTL değerleri 60 ile 60000 saniye arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення TTL хоста Namecheap мають бути від 60 до 60 000 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị TTL của máy chủ Namecheap phải nằm trong khoảng từ 60 đến 60000 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap 主机 TTL 值必须介于 60 到 60000 秒之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap 主機 TTL 值必須介於 60 到 60000 秒之間。"
          }
        }
      }
    },
    "Namecheap requires the public IPv4 address making API requests. Add this address under Namecheap API Access → Whitelisted IPs, then enter the same address here. If your public IP changes, update it in both places.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap benötigt die öffentliche IPv4-Adresse für API-Anfragen. Fügen Sie diese Adresse unter Namecheap API Access → Whitelisted IPs hinzu und geben Sie dann dieselbe Adresse hier ein. Wenn sich Ihre öffentliche IP ändert, aktualisieren Sie sie an beiden Stellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap requiere la dirección IPv4 pública para realizar solicitudes de API. Agregue esta dirección en Acceso a la API de Namecheap → IP en la lista blanca, luego ingrese la misma dirección aquí. Si tu IP pública cambia, actualízala en ambos lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap nécessite l'adresse IPv4 publique pour effectuer des requêtes API. Ajoutez cette adresse sous Namecheap API Access → IPs sur liste blanche, puis entrez la même adresse ici. Si votre adresse IP publique change, mettez-la à jour aux deux endroits."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap को API अनुरोध करने के लिए सार्वजनिक IPv4 पते की आवश्यकता होती है। इस पते को नेमचीप एपीआई एक्सेस → व्हाइटलिस्टेड आईपी के तहत जोड़ें, फिर वही पता यहां दर्ज करें। यदि आपका सार्वजनिक आईपी बदलता है, तो इसे दोनों स्थानों पर अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap memerlukan alamat IPv4 publik yang membuat permintaan API. Tambahkan alamat ini di bawah Akses API Namecheap → IP yang Masuk Daftar Putih, lalu masukkan alamat yang sama di sini. Jika IP publik Anda berubah, perbarui di kedua tempat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap では、API リクエストを行うパブリック IPv4 アドレスが必要です。このアドレスを「Namecheap API Access」→「Whitelisted IPs」の下に追加し、ここに同じアドレスを入力します。パブリック IP が変更された場合は、両方の場所で更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap에는 API 요청을 수행하는 공용 IPv4 주소가 필요합니다. Namecheap API 액세스 → 화이트리스트 IP 아래에 이 주소를 추가한 다음 여기에 동일한 주소를 입력하세요. 공용 IP가 변경되면 두 곳 모두에서 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap wymaga publicznego adresu IPv4 wysyłającego żądania API. Dodaj ten adres w obszarze Dostęp do API Namecheap → Adresy IP na białej liście, a następnie wprowadź tutaj ten sam adres. Jeśli Twój publiczny adres IP ulegnie zmianie, zaktualizuj go w obu miejscach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap requer o endereço IPv4 público para fazer solicitações de API. Adicione este endereço em Namecheap API Access → IPs na lista de permissões e insira o mesmo endereço aqui. Se o seu IP público mudar, atualize-o em ambos os lugares."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap, API istekleri yapan genel IPv4 adresini gerektirir. Bu adresi Namecheap API Erişimi → Beyaz Listeye Alınan IP'ler altına ekleyin, ardından aynı adresi buraya girin. Genel IP'niz değişirse her iki yerde de güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap вимагає загальнодоступної адреси IPv4 для надсилання запитів API. Додайте цю адресу в розділі Namecheap API Access → IP-адреси в білому списку, а потім введіть ту саму адресу тут. Якщо ваша публічна IP-адреса зміниться, оновіть її в обох місцях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap yêu cầu địa chỉ IPv4 công khai thực hiện các yêu cầu API. Thêm địa chỉ này trong Truy cập API Namecheap → IP được liệt kê trong danh sách trắng, sau đó nhập cùng một địa chỉ vào đây. Nếu IP công cộng của bạn thay đổi, hãy cập nhật nó ở cả hai nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap 需要公共 IPv4 地址来发出 API 请求。在 Namecheap API Access → 白名单 IP 下添加此地址，然后在此处输入相同的地址。如果您的公共 IP 发生变化，请在两个地方进行更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap 需要一個公共 IPv4 位址來發出 API 請求。在 Namecheap API Access → 白名單 IP 下新增此位址，然後在此輸入相同的位址。如果您的公共 IP 發生變化，請在兩個地方進行更新。"
          }
        }
      }
    },
