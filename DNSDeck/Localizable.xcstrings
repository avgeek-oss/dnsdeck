    "VS Code and Cursor use different MCP JSON formats. Copy the one for your app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code und Cursor verwenden unterschiedliche MCP JSON-Formate. Kopieren Sie das für Ihre App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code and Cursor use different MCP JSON formats. Copy the one for your app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code y Cursor utilizan diferentes formatos MCP JSON. Copie el de su aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code et Cursor utilisent des formats MCP JSON différents. Copiez celui de votre application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code और Cursor विभिन्न MCP JSON प्रारूपों का उपयोग करते हैं। अपने ऐप के लिए उसे कॉपी करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code dan Cursor menggunakan format MCP JSON yang berbeda. Salin yang untuk aplikasi Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code と Cursor は、異なる MCP JSON 形式を使用します。アプリ用のものをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code 및 Cursor는 서로 다른 MCP JSON 형식을 사용합니다. 앱용 항목을 복사하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code i Cursor używają różnych formatów MCP JSON. Skopiuj ten dla swojej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code e Cursor usam formatos MCP JSON diferentes. Copie aquele para o seu aplicativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code ve Cursor, farklı MCP JSON formatlarını kullanır. Uygulamanız için olanı kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code і Cursor використовують різні формати MCP JSON. Скопіюйте його для своєї програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code và Cursor sử dụng các định dạng MCP JSON khác nhau. Sao chép một cái cho ứng dụng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code 和 Cursor 使用不同的 MCP JSON 格式。复制您的应用程序的一份。"
