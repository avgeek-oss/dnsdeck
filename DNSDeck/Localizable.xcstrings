  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"%@\"": {},
    "\"%@\" is not a valid nameserver hostname.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein gültiger Nameserver-Hostname."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" no es un nombre de host de servidor de nombres válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" n'est pas un nom d'hôte de serveur de noms valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" एक वैध नेमसर्वर होस्टनाम नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" bukan nama host server nama yang valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は有効なネームサーバーのホスト名ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"는 유효한 이름 서버 호스트 이름이 아닙니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest prawidłową nazwą hosta serwera nazw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" não é um nome de host de servidor de nomes válido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" geçerli bir ad sunucusu ana bilgisayar adı değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" не є дійсним іменем хоста сервера імен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" không phải là tên máy chủ máy chủ định danh hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的名称服务器主机名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的名稱伺服器主機名稱。"
          }
        }
      }
    },
