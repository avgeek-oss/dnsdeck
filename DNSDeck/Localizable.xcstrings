    "For example, https://dns.example.com/api/v1. DNSDeck appends /api/v1 when omitted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: https://dns.example.com/api/v1. DNSDeck hängt /api/v1 an, wenn es weggelassen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo, https://dns.example.com/api/v1. DNSDeck agrega /api/v1 cuando se omite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple, https://dns.example.com/api/v1. DNSDeck ajoute /api/v1 en cas d'omission."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण के लिए, https://dns.example.com/api/v1. हटाए जाने पर DNSDeck /api/v1 जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Misalnya, https://dns.example.com/api/v1. DNSDeck menambahkan /api/v1 ketika dihilangkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たとえば、https://dns.example.com/api/v1 です。 DNSDeck は省略すると /api/v1 を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 들어 https://dns.example.com/api/v1입니다. DNSDeck은 생략되면 /api/v1을 추가합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na przykład https://dns.example.com/api/v1. DNSDeck dołącza /api/v1 w przypadku pominięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, https://dns.example.com/api/v1. DNSDeck anexa /api/v1 quando omitido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin, https://dns.example.com/api/v1. DNSDeck atlandığında /api/v1'i ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наприклад, https://dns.example.com/api/v1. DNSDeck додає /api/v1, якщо його пропущено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví dụ: https://dns.example.com/api/v1. DNSDeck nối thêm /api/v1 khi bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如，https://dns.example.com/api/v1。当省略时，DNSDeck 会附加 /api/v1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如，https://dns.example.com/api/v1。當省略時，DNSDeck 會附加 /api/v1。"
          }
        }
      }
    },
