          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 자격 증명에 대한 도움을 받으려면 다음 링크를 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj poniższego łącza, aby uzyskać pomoc dotyczącą poświadczeń %@"
          }
        },
        "pt-BR": {
