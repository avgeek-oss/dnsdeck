    "The zone has been added. To complete the activation, you would need to copy the name servers and add it to your domain provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zone wurde hinzugefügt. Um die Aktivierung abzuschließen, müssen Sie die Nameserver kopieren und zu Ihrem Domain-Anbieter hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona ha sido agregada. Para completar la activación, deberá copiar los servidores de nombres y agregarlos a su proveedor de dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone a été ajoutée. Pour terminer l'activation, vous devrez copier les serveurs de noms et les ajouter à votre fournisseur de domaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोन जोड़ दिया गया है. सक्रियण पूरा करने के लिए, आपको नाम सर्वर की प्रतिलिपि बनाना होगा और इसे अपने डोमेन प्रदाता में जोड़ना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona telah ditambahkan. Untuk menyelesaikan aktivasi, Anda perlu menyalin server nama dan menambahkannya ke penyedia domain Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゾーンが追加されました。アクティベーションを完了するには、ネーム サーバーをコピーし、ドメイン プロバイダーに追加する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이 추가되었습니다. 활성화를 완료하려면 이름 서버를 복사하여 도메인 공급자에 추가해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefa została dodana. Aby dokończyć aktywację, musisz skopiować serwery nazw i dodać je do swojego dostawcy domeny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona foi adicionada. Para concluir a ativação, você precisará copiar os servidores de nomes e adicioná-los ao seu provedor de domínio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge eklendi. Etkinleştirmeyi tamamlamak için ad sunucularını kopyalayıp alan adı sağlayıcınıza eklemeniz gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона додана. Щоб завершити активацію, вам потрібно скопіювати сервери імен і додати їх до постачальника домену."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vực đã được thêm vào. Để hoàn tất quá trình kích hoạt, bạn cần sao chép máy chủ định danh và thêm nó vào nhà cung cấp tên miền của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该区域已添加。要完成激活，您需要复制名称服务器并将其添加到您的域提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該區域已新增。要完成激活，您需要複製名稱伺服器並將其添加到您的網域提供者。"
          }
        }
      }
    },
    "This record will be deleted and cannot be reversed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz wird gelöscht und kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro se eliminará y no se podrá revertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement sera supprimé et ne pourra pas être annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिकॉर्ड हटा दिया जाएगा और इसे उलटा नहीं किया जा सकेगा."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan ini akan dihapus dan tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録は削除され、元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록은 삭제되며 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten rekord zostanie usunięty i nie będzie można go cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro será excluído e não poderá ser revertido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt silinecek ve geri alınamayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запис буде видалено, і його неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi này sẽ bị xóa và không thể đảo ngược."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该记录将被删除且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該記錄將被刪除且無法撤銷。"
          }
        }
      }
    },
    "This will remove your %@ credentials. You can reconnect at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihre %@-Anmeldeinformationen entfernt. Sie können die Verbindung jederzeit wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará sus credenciales %@. Puedes volver a conectarte en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera vos informations d'identification %@. Vous pouvez vous reconnecter à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके %@ क्रेडेंशियल्स को हटा देगा। आप किसी भी समय पुनः कनेक्ट कर सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus kredensial %@ Anda. Anda dapat menyambung kembali kapan saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、%@ 資格情報が削除されます。いつでも再接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 %@ 자격 증명이 제거됩니다. 언제든지 다시 연결할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie poświadczeń %@. Możesz połączyć się ponownie w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá suas credenciais %@. Você pode se reconectar a qualquer momento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, %@ kimlik bilgilerinizi kaldıracaktır. İstediğiniz zaman yeniden bağlanabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить ваші облікові дані %@. Ви можете будь-коли повторно підключитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa thông tin đăng nhập %@ của bạn. Bạn có thể kết nối lại bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除您的 %@ 凭据。您可以随时重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除您的 %@ 憑證。您可以隨時重新連線。"
          }
        }
      }
    },
