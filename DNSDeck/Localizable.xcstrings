    "Connect a provider to view your zones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie einen Anbieter, um Ihre Zonen anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte un proveedor para ver sus zonas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un fournisseur pour afficher vos zones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने क्षेत्र देखने के लिए एक प्रदाता से कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan penyedia untuk melihat zona Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーに接続してゾーンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 보려면 공급자를 연결하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z dostawcą, aby wyświetlić swoje strefy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um provedor para visualizar suas zonas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgelerinizi görüntülemek için bir sağlayıcıya bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть провайдера для перегляду зон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối một nhà cung cấp để xem các khu vực của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接提供商以查看您的区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接提供者以查看您的區域。"
          }
        }
      }
    },
    "Connect a supported provider to add a zone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie einen unterstützten Anbieter, um eine Zone hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte un proveedor compatible para agregar una zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un fournisseur pris en charge pour ajouter une zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ोन जोड़ने के लिए किसी समर्थित प्रदाता से कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan penyedia yang didukung untuk menambahkan zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされているプロバイダーに接続してゾーンを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 추가하려면 지원되는 공급자를 연결하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z obsługiwanym dostawcą, aby dodać strefę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um provedor compatível para adicionar uma zona."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge eklemek için desteklenen bir sağlayıcıya bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до підтримуваного провайдера, щоб додати зону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối nhà cung cấp được hỗ trợ để thêm vùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接受支持的提供商以添加区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接受支援的提供者以增加區域。"
          }
