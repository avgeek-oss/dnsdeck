    "All selected records already exist in the destination zone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ausgewählten Datensätze sind bereits in der Zielzone vorhanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros seleccionados ya existen en la zona de destino."
          }
        },
