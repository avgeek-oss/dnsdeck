    "Porkbun defaults omitted or zero TTLs to the account minimum, typically 600 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Porkbun werden standardmäßig weggelassene oder null TTLs auf das Kontominimum, normalerweise 600 Sekunden, zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores predeterminados de Porkbun se omiten o no hay TTL en el mínimo de la cuenta, normalmente 600 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun est omis par défaut ou zéro TTL par rapport au minimum du compte, généralement 600 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्कबुन डिफ़ॉल्ट रूप से खाते में न्यूनतम 600 सेकंड के लिए छोड़े गए या शून्य टीटीएल को छोड़ देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Porkbun dihilangkan atau TTL nol pada minimum akun, biasanya 600 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun のデフォルトでは、TTL が省略されているか、アカウントの最小値 (通常は 600 秒) がゼロになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun은 기본적으로 생략되거나 계정 최소값(일반적으로 600초)에 대한 TTL이 0입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun domyślnie pominął lub zerował TTL do minimum konta, zwykle 600 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões do Porkbun são omitidos ou zero TTLs no mínimo da conta, normalmente 600 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun varsayılanları atlanır veya hesap minimumuna TTL'ler sıfırlanır, genellikle 600 saniye."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun за замовчуванням пропускає або нуль TTL до мінімального облікового запису, зазвичай 600 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun mặc định bị bỏ qua hoặc không có TTL ở mức tối thiểu của tài khoản, thường là 600 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun 默认忽略帐户的最小 TTL 或将 TTL 设置为零，通常为 600 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Porkbun 預設忽略帳戶的最小 TTL 或將 TTL 設為零，通常為 600 秒。"
          }
        }
      }
    },
