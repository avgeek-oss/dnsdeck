    "Record TTL is rounded up to the next Linode API value between 300 and 2419200 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rekord-TTL wird auf den nächsten Linode-API-Wert zwischen 300 und 2419200 Sekunden aufgerundet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El TTL del registro se redondea al siguiente valor de API de Linode entre 300 y 2419200 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée de vie de l'enregistrement est arrondie à la valeur API Linode suivante entre 300 et 2 419 200 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड टीटीएल को 300 और 2419200 सेकंड के बीच अगले लिनोड एपीआई मान तक पूर्णांकित किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan TTL dibulatkan ke nilai Linode API berikutnya antara 300 dan 2419200 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコード TTL は、300 ～ 2419200 秒の次の Linode API 値に切り上げられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드 TTL은 300초에서 2419200초 사이의 다음 Linode API 값으로 반올림됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekord TTL jest zaokrąglany w górę do następnej wartości API Linode z zakresu od 300 do 2419200 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro TTL é arredondado para o próximo valor da API Linode entre 300 e 2.419.200 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL kaydı, 300 ile 2419200 saniye arasındaki bir sonraki Linode API değerine yuvarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис TTL округлюється до наступного значення Linode API від 300 до 2419200 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi TTL được làm tròn thành giá trị API Linode tiếp theo trong khoảng từ 300 đến 2419200 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录 TTL 向上舍入到 300 到 2419200 秒之间的下一个 Linode API 值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄 TTL 向上舍入到 300 到 2419200 秒之間的下一個 Linode API 值。"
          }
        }
      }
    },
