    "GoDaddy DNS records use TTL values from 600 seconds through one week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GoDaddy-DNS-Einträge verwenden TTL-Werte von 600 Sekunden bis zu einer Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros DNS de GoDaddy utilizan valores TTL desde 600 segundos hasta una semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements DNS GoDaddy utilisent des valeurs TTL allant de 600 secondes à une semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GoDaddy DNS रिकॉर्ड 600 सेकंड से एक सप्ताह तक TTL मानों का उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan DNS GoDaddy menggunakan nilai TTL dari 600 detik hingga satu minggu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoDaddy DNS レコードは、600 秒から 1 週間までの TTL 値を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GoDaddy DNS 레코드는 600초에서 1주일까지의 TTL 값을 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordy DNS GoDaddy wykorzystują wartości TTL od 600 sekund do jednego tygodnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros DNS do GoDaddy usam valores TTL de 600 segundos a uma semana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GoDaddy DNS kayıtları 600 saniyeden bir haftaya kadar TTL değerlerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи GoDaddy DNS використовують значення TTL від 600 секунд до одного тижня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi DNS của GoDaddy sử dụng giá trị TTL từ 600 giây đến một tuần."
          }
        },
        "zh-Hans": {
