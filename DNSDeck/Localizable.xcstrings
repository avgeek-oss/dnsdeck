        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de conectar um provedor, selecione uma zona para visualizar e gerenciar registros DNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sağlayıcıya bağlandığınızda, DNS kayıtlarını görüntülemek ve yönetmek için bir bölge seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після підключення постачальника виберіть зону для перегляду та керування записами DNS."
          }
        },
        "vi": {
