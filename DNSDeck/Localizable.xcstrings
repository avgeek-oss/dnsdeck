    "Scaleway models TTL as an unsigned 32-bit number and versions every DNS record change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway modelliert TTL als vorzeichenlose 32-Bit-Zahl und versioniert jede DNS-Eintragsänderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway modela TTL como un número de 32 bits sin firmar y versiona cada cambio de registro DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway modélise le TTL sous la forme d'un numéro 32 bits non signé et met à jour chaque modification d'enregistrement DNS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्केलवे टीटीएल को एक अहस्ताक्षरित 32-बिट संख्या के रूप में मॉडल करता है और प्रत्येक DNS रिकॉर्ड परिवर्तन को संस्करणित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway memodelkan TTL sebagai nomor 32-bit yang tidak ditandatangani dan membuat versi setiap perubahan data DNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway は、TTL を符号なしの 32 ビット数値としてモデル化し、DNS レコードが変更されるたびにバージョンを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway는 TTL을 부호 없는 32비트 숫자로 모델링하고 DNS 레코드가 변경될 때마다 버전을 지정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway modeluje TTL jako 32-bitową liczbę bez znaku i wersjonuje każdą zmianę rekordu DNS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scaleway modela o TTL como um número não assinado de 32 bits e cria versões de cada alteração no registro DNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway, TTL'yi imzasız 32 bitlik bir sayı olarak modeller ve her DNS kaydında değişen sürümler sunar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway моделює TTL як 32-розрядне число без знаку та версії кожної зміни запису DNS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalway mô hình hóa TTL dưới dạng số 32 bit không dấu và các phiên bản mỗi bản ghi DNS thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway 将 TTL 建模为无符号 32 位数字，并针对每次 DNS 记录更改进行版本控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaleway 將 TTL 建模為無符號 32 位元數字，並針對每次 DNS 記錄變更進行版本控制。"
          }
        }
      }
    },
