    "• Route53: TTL defaults to 300 seconds if not specified": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: TTL beträgt standardmäßig 300 Sekunden, wenn nicht angegeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Ruta 53: TTL tiene un valor predeterminado de 300 segundos si no se especifica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53 : TTL par défaut à 300 secondes si non spécifié"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• रूट53: यदि निर्दिष्ट नहीं है तो टीटीएल 300 सेकंड पर डिफॉल्ट हो जाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: TTL defaultnya adalah 300 detik jika tidak ditentukan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: 指定しない場合、TTL はデフォルトで 300 秒になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: 지정되지 않은 경우 TTL의 기본값은 300초입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: TTL domyślnie wynosi 300 sekund, jeśli nie jest określone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: o padrão do TTL é 300 segundos se não for especificado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: Belirtilmezse TTL varsayılan olarak 300 saniyeye ayarlanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: TTL за замовчуванням становить 300 секунд, якщо не вказано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53: TTL mặc định là 300 giây nếu không được chỉ định"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53：如果未指定，TTL 默认为 300 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "• Route53：如果未指定，TTL 預設為 300 秒"
          }
        }
      }
    },
