    "TTL is sent as whole seconds; Vultr's API does not publish a narrower numeric range.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL wird als ganze Sekunden gesendet; Die API von Vultr veröffentlicht keinen engeren numerischen Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL se envía en segundos completos; La API de Vultr no publica un rango numérico más estrecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le TTL est envoyé sous forme de secondes entières ; L'API de Vultr ne publie pas de plage numérique plus étroite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीटीएल पूरे सेकंड के रूप में भेजा जाता है; Vultr का एपीआई एक संकीर्ण संख्यात्मक श्रेणी प्रकाशित नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL dikirim dalam hitungan detik; API Vultr tidak menerbitkan rentang numerik yang lebih sempit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL は秒単位で送信されます。 Vultr の API は、これより狭い数値範囲を公開しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL은 전체 초 단위로 전송됩니다. Vultr의 API는 더 좁은 숫자 범위를 게시하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL jest wysyłany jako pełne sekundy; Interfejs API Vultr nie publikuje węższego zakresu liczbowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TTL é enviado em segundos inteiros; A API do Vultr não publica um intervalo numérico mais restrito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL tam saniye olarak gönderilir; Vultr'un API'si daha dar bir sayısal aralık yayınlamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL надсилається як цілі секунди; API Vultr не публікує вужчий числовий діапазон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL được gửi dưới dạng toàn bộ giây; API của Vultr không công bố phạm vi số hẹp hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL 以整秒形式发送； Vultr 的 API 不会发布更窄的数值范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL 以整秒形式發送； Vultr 的 API 不會發布更窄的數值範圍。"
          }
        }
      }
    },
    "TTL must be at least 1 second. DigitalOcean may align TTLs for records in the same RRset.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL muss mindestens 1 Sekunde betragen. DigitalOcean kann TTLs für Datensätze im selben RRset ausrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL debe ser de al menos 1 segundo. DigitalOcean puede alinear TTL para registros en el mismo RRset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le TTL doit être d'au moins 1 seconde. DigitalOcean peut aligner les durées de vie des enregistrements dans le même RRset."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीटीएल कम से कम 1 सेकंड का होना चाहिए. DigitalOcean उसी RRset में रिकॉर्ड के लिए TTL को संरेखित कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL harus minimal 1 detik. DigitalOcean dapat menyelaraskan TTL untuk rekaman di RRset yang sama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL は少なくとも 1 秒である必要があります。 DigitalOcean は、同じ RRset 内のレコードの TTL を調整する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL은 1초 이상이어야 합니다. DigitalOcean은 동일한 RRset의 레코드에 대한 TTL을 정렬할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL musi wynosić co najmniej 1 sekundę. DigitalOcean może wyrównać TTL dla rekordów w tym samym zestawie RR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TTL deve ser de pelo menos 1 segundo. A DigitalOcean pode alinhar TTLs para registros no mesmo RRset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL en az 1 saniye olmalıdır. DigitalOcean, aynı RRset'teki kayıtlar için TTL'leri hizalayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL має бути не менше 1 секунди. DigitalOcean може вирівнювати TTL для записів в одному наборі RRset."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL phải dài ít nhất 1 giây. DigitalOcean có thể căn chỉnh các TTL cho các bản ghi trong cùng một tập bản ghi tài nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL 必须至少为 1 秒。 DigitalOcean 可以对齐同一 RR 集中记录的 TTL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL 必須至少為 1 秒。 DigitalOcean 可以對齊同一 RR 集中記錄的 TTL。"
          }
        }
      }
    },
