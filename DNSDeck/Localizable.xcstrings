    "LiveDNS accepts RRset TTL values from 300 through 2592000 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS akzeptiert RRset-TTL-Werte von 300 bis 2592000 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS acepta valores RRset TTL de 300 a 2592000 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS accepte les valeurs TTL RRset comprises entre 300 et 2 592 000 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS 300 से 2592000 सेकंड तक RRset TTL मान स्वीकार करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS menerima nilai RRset TTL dari 300 hingga 2592000 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS は、300 ～ 2592000 秒の RRset TTL 値を受け入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS는 300~2592000초의 RRset TTL 값을 허용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS akceptuje wartości RRset TTL od 300 do 2592000 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS aceita valores RRset TTL de 300 a 2.592.000 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS, 300 ila 2592000 saniye arasındaki RRset TTL değerlerini kabul eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS приймає значення RRset TTL від 300 до 2592000 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS chấp nhận các giá trị RRset TTL từ 300 đến 2592000 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS 接受 RRset TTL 值从 300 到 2592000 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveDNS 接受 RRset TTL 值從 300 到 2592000 秒。"
          }
        }
      }
    },
