    "%lld record%@ already exist in the destination and will be skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag %1$lld%2$@ ist bereits im Ziel vorhanden und wird übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld record%2$@ already exist in the destination and will be skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro %1$lld%2$@ ya existe en el destino y se omitirá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement %1$lld%2$@ existe déjà dans la destination et sera ignoré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld रिकॉर्ड%2$@ पहले से ही गंतव्य में मौजूद है और छोड़ दिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld record%2$@ sudah ada di tujuan dan akan dilewati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld レコード%2$@ は宛先にすでに存在するため、スキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 레코드%2$@가 대상에 이미 있으므로 건너뜁니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekord %1$lld%2$@ już istnieje w miejscu docelowym i zostanie pominięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro %1$lld%2$@ já existe no destino e será ignorado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kaydı%2$@ hedefte zaten mevcut ve atlanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис %1$lld%2$@ уже існує в цільовій системі та буде пропущено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi %1$lld%2$@ đã tồn tại ở đích và sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 记录%2$@ 已存在于目标中，将被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 記錄%2$@ 已存在於目標中，將被跳過。"
          }
        }
      }
    },
    "%lld record%@ will be deleted and cannot be reversed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag %1$lld%2$@ wird gelöscht und kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld record%2$@ will be deleted and cannot be reversed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro %1$lld%2$@ se eliminará y no se podrá revertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement %1$lld%2$@ sera supprimé et ne pourra pas être annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld रिकॉर्ड%2$@ हटा दिया जाएगा और इसे उलटा नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld record%2$@ akan dihapus dan tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld レコード%2$@ は削除され、元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 레코드%2$@가 삭제되며 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekord %1$lld%2$@ zostanie usunięty i nie będzie można go cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro %1$lld%2$@ será excluído e não poderá ser revertido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kaydı%2$@ silinecek ve geri alınamayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld запис %2$@ буде видалено, і його неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi %1$lld%2$@ sẽ bị xóa và không thể đảo ngược được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 记录%2$@ 将被删除且无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 記錄%2$@ 將被刪除且無法撤銷。"
          }
        }
      }
    },
