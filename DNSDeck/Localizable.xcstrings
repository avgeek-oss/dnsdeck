    "Leave empty for a personal account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein persönliches Konto leer lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para una cuenta personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser vide pour un compte personnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत खाते को खाली छोड़ दें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk akun pribadi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人アカウントの場合は空のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 계정의 경우 비워 두세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste dla konta osobistego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para uma conta pessoal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel hesap için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім для особистого облікового запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống cho tài khoản cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于个人帐户留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於個人帳戶留空。"
          }
        }
      }
    },
    "Leave empty for oraclecloud.com. Enter the OCI realm domain only for a government or sovereign realm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für oraclecloud.com leer lassen. Geben Sie die OCI-Realm-Domäne nur für einen Regierungs- oder Hoheitsbereich ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para oraclecloud.com. Ingrese al dominio del reino OCI solo para un reino gubernamental o soberano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour oraclecloud.com. Entrez le domaine du domaine OCI uniquement pour un domaine gouvernemental ou souverain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraclecloud.com के लिए खाली छोड़ें। ओसीआई क्षेत्र डोमेन केवल सरकारी या संप्रभु क्षेत्र के लिए दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk Oraclecloud.com. Masuk ke domain ranah OCI hanya untuk ranah pemerintahan atau kedaulatan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "oraclecloud.com の場合は空のままにします。政府または主権レルムの OCI レルム ドメインのみを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "oraclecloud.com의 경우 비워 두세요. 정부 또는 주권 영역에 대해서만 OCI 영역 도메인을 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste dla oraclecloud.com. Wprowadź domenę domeny OCI tylko dla domeny rządowej lub suwerennej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para oraclecloud.com. Insira o domínio OCI apenas para um domínio governamental ou soberano."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraclecloud.com için boş bırakın. OCI alanı alanına yalnızca bir hükümet veya egemen bölge için girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім для oraclecloud.com. Введіть домен сфери OCI лише для урядової чи суверенної сфери."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống cho oraclecloud.com. Chỉ nhập miền vương quốc OCI cho chính phủ hoặc vương quốc có chủ quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 oraclecloud.com 留空。仅输入政府或主权领域的 OCI 领域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 oraclecloud.com 留空。僅輸入政府或主權領域的 OCI 領域。"
          }
        }
      }
    },
    "Leave empty for production, or enter sandbox to use a separate Namecheap sandbox account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Produktion leer lassen oder Sandbox eingeben, um ein separates Namecheap-Sandbox-Konto zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para producción o ingrese a la zona de pruebas para usar una cuenta de zona de pruebas de Namecheap separada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour la production ou entrez sandbox pour utiliser un compte sandbox Namecheap distinct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्पादन के लिए खाली छोड़ें, या एक अलग नेमचीप सैंडबॉक्स खाते का उपयोग करने के लिए सैंडबॉक्स दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk produksi, atau masuk ke sandbox untuk menggunakan akun sandbox Namecheap terpisah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本番環境では空のままにするか、サンドボックスを入力して別の Namecheap サンドボックス アカウントを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로덕션을 위해 비워두거나 별도의 Namecheap 샌드박스 계정을 사용하려면 샌드박스를 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste na potrzeby produkcyjne lub wejdź do piaskownicy, aby użyć osobnego konta piaskownicy Namecheap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para produção ou entre no sandbox para usar uma conta separada do sandbox Namecheap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üretim için boş bırakın veya ayrı bir Namecheap korumalı alan hesabı kullanmak için korumalı alana girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім для виробництва або введіть пісочницю, щоб використовувати окремий обліковий запис пісочниці Namecheap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để sản xuất hoặc nhập hộp cát để sử dụng tài khoản hộp cát Namecheap riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于生产留空，或输入沙箱以使用单独的 Namecheap 沙箱帐户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於生產留空，或輸入沙箱以使用單獨的 Namecheap 沙箱帳戶。"
          }
        }
      }
    },
