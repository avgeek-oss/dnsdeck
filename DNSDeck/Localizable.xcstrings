    "Cache zones and records locally to reduce API calls and improve performance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachen Sie Zonen und Datensätze lokal, um API-Aufrufe zu reduzieren und die Leistung zu verbessern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacene en caché zonas y registros localmente para reducir las llamadas API y mejorar el rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachez les zones et les enregistrements localement pour réduire les appels d'API et améliorer les performances"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एपीआई कॉल को कम करने और प्रदर्शन में सुधार करने के लिए स्थानीय स्तर पर कैश ज़ोन और रिकॉर्ड"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona cache dan catatan secara lokal untuk mengurangi panggilan API dan meningkatkan kinerja"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゾーンとレコードをローカルにキャッシュして API 呼び出しを減らし、パフォーマンスを向上させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역과 레코드를 로컬로 캐시하여 API 호출을 줄이고 성능을 향상시킵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefy pamięci podręcznej i rekordy lokalnie, aby zmniejszyć liczbę wywołań API i poprawić wydajność"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazene zonas e registros em cache localmente para reduzir chamadas de API e melhorar o desempenho"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API çağrılarını azaltmak ve performansı artırmak için bölgeleri ve kayıtları yerel olarak önbelleğe alın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальне кешування зон і записів для зменшення викликів API і підвищення продуктивності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng đệm và bản ghi cục bộ để giảm lệnh gọi API và cải thiện hiệu suất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地缓存区域和记录以减少 API 调用并提高性能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地快取區域和記錄以減少 API 呼叫並提高效能"
          }
        }
      }
    },
