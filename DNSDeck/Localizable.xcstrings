    "Use the following link to get help with %@ credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie den folgenden Link, um Hilfe zu den %@-Anmeldeinformationen zu erhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el siguiente enlace para obtener ayuda con las credenciales %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le lien suivant pour obtenir de l'aide concernant les informations d'identification %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ क्रेडेंशियल्स के साथ सहायता प्राप्त करने के लिए निम्नलिखित लिंक का उपयोग करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
