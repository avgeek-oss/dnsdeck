    "DNSDeck includes a local STDIO MCP helper. MCP apps start it when they connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck enthält einen lokalen STDIO MCP-Helfer. MCP-Apps starten es, wenn sie eine Verbindung herstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck includes a local STDIO MCP helper. MCP apps start it when they connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck incluye un asistente local STDIO MCP. Las aplicaciones MCP lo inician cuando se conectan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck inclut un assistant local STDIO MCP. Les applications MCP le démarrent lorsqu'elles se connectent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck में एक स्थानीय STDIO MCP सहायक शामिल है। ZXQDNSDEKTERM0002QXZ ऐप्स कनेक्ट होने पर इसे प्रारंभ करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck menyertakan pembantu STDIO MCP lokal. Aplikasi MCP memulainya saat terhubung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck には、ローカル STDIO MCP ヘルパーが含まれています。 MCP アプリは接続時に起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck에는 로컬 STDIO MCP 도우미가 포함되어 있습니다. MCP 앱은 연결될 때 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck zawiera lokalnego pomocnika STDIO MCP. Aplikacje MCP uruchamiają go po nawiązaniu połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck inclui um auxiliar local STDIO MCP. Os aplicativos MCP iniciam quando se conectam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck, yerel bir STDIO MCP yardımcısını içerir. ZXQDNSSDECKTERM0002QXZ uygulamaları bağlandıklarında bunu başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck містить локальний помічник STDIO MCP. Програми MCP запускають його під час підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck bao gồm trình trợ giúp STDIO MCP cục bộ. Các ứng dụng MCP khởi động nó khi chúng kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck 包括本地 STDIO MCP 帮助程序。 MCP 应用程序在连接时启动它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck 包含本機 STDIO MCP 幫助程式。 MCP 應用程式在連接時啟動它。"
          }
        }
      }
    },
    "DNSDeck uses IONOS's recommended 3600-second TTL and a conservative 300-second minimum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck verwendet die von IONOS empfohlene TTL von 3600 Sekunden und ein konservatives Minimum von 300 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck utiliza el TTL de 3600 segundos recomendado por IONOS y un mínimo conservador de 300 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck utilise la durée de vie recommandée par IONOS de 3 600 secondes et un minimum conservateur de 300 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck IONOS की अनुशंसित 3600-सेकंड TTL और एक रूढ़िवादी 300-सेकंड न्यूनतम का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck menggunakan TTL 3600 detik yang direkomendasikan IONOS dan minimum konservatif 300 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck は、IONOS が推奨する 3600 秒の TTL と控えめな最小値の 300 秒を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck은 IONOS에서 권장하는 3600초 TTL과 보수적인 최소 300초를 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck wykorzystuje zalecany przez IONOS czas TTL wynoszący 3600 sekund i konserwatywne minimum 300 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck usa o TTL recomendado de 3.600 segundos do IONOS e um mínimo conservador de 300 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck, IONOS'un önerdiği 3600 saniyelik TTL'yi ve muhafazakar bir minimum 300 saniyelik TTL'yi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck використовує рекомендований IONOS 3600-секундний TTL і консервативний мінімум у 300 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck sử dụng TTL 3600 giây được đề xuất của IONOS và mức tối thiểu 300 giây vừa phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck 使用 IONOS 建议的 3600 秒 TTL 和保守的最小值 300 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSDeck 使用 IONOS 建議的 3600 秒 TTL 和保守的最小值 300 秒。"
          }
        }
      }
    },
    "DNSimple's OpenAPI contract accepts non-negative TTL values and defaults to 3600 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der OpenAPI-Vertrag von DNSimple akzeptiert nicht negative TTL-Werte und ist standardmäßig auf 3600 Sekunden eingestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contrato OpenAPI de DNSimple acepta valores TTL no negativos y el valor predeterminado es 3600 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrat OpenAPI de DNSimple accepte des valeurs TTL non négatives et la valeur par défaut est de 3 600 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSimple का OpenAPI अनुबंध गैर-नकारात्मक TTL मान स्वीकार करता है और 3600 सेकंड पर डिफ़ॉल्ट होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrak OpenAPI DNSimple menerima nilai TTL non-negatif dan defaultnya adalah 3600 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSimple の OpenAPI コントラクトは、負でない TTL 値を受け入れ、デフォルトは 3600 秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSimple의 OpenAPI 계약은 음수가 아닌 TTL 값을 허용하며 기본값은 3600초입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrakt OpenAPI DNSimple akceptuje nieujemne wartości TTL i domyślnie wynosi 3600 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contrato OpenAPI do DNSimple aceita valores TTL não negativos e o padrão é 3600 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSimple'ın OpenAPI sözleşmesi negatif olmayan TTL değerlerini kabul eder ve varsayılan olarak 3600 saniyedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контракт DNSimple OpenAPI приймає невід’ємні значення TTL і за замовчуванням становить 3600 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hợp đồng OpenAPI của DNSimple chấp nhận các giá trị TTL không âm và mặc định là 3600 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
