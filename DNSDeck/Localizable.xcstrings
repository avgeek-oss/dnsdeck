    "Automatic TTL is supported. Manual values must be between 60 and 86400 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches TTL wird unterstützt. Manuelle Werte müssen zwischen 60 und 86400 Sekunden liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admite TTL automático. Los valores manuales deben estar entre 60 y 86400 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le TTL automatique est pris en charge. Les valeurs manuelles doivent être comprises entre 60 et 86 400 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित टीटीएल समर्थित है. मैन्युअल मान 60 और 86400 सेकंड के बीच होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL otomatis didukung. Nilai manual harus antara 60 dan 86400 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動 TTL がサポートされています。手動値は 60 ～ 86400 秒である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 TTL이 지원됩니다. 수동 값은 60~86400초 사이여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługiwany jest automatyczny TTL. Wartości ręczne muszą mieścić się w przedziale od 60 do 86400 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL automático é suportado. Os valores manuais devem estar entre 60 e 86.400 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik TTL desteklenir. Manuel değerler 60 ile 86400 saniye arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримується автоматичний TTL. Значення, встановлені вручну, мають бути від 60 до 86400 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TTL tự động được hỗ trợ. Giá trị thủ công phải nằm trong khoảng từ 60 đến 86400 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持自动TTL。手动值必须介于 60 到 86400 秒之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援自動TTL。手動值必須介於 60 到 86400 秒之間。"
          }
        }
      }
    },
    "Automatic uses the zone default TTL. Explicit values must be between 60 and 2147483647 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch verwendet die Zonen-Standard-TTL. Explizite Werte müssen zwischen 60 und 2147483647 Sekunden liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático utiliza el TTL predeterminado de la zona. Los valores explícitos deben estar entre 60 y 2147483647 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique utilise la durée de vie par défaut de la zone. Les valeurs explicites doivent être comprises entre 60 et 2 147 483 647 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित ज़ोन डिफ़ॉल्ट टीटीएल का उपयोग करता है। स्पष्ट मान 60 और 2147483647 सेकंड के बीच होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatis menggunakan TTL default zona. Nilai eksplisit harus antara 60 dan 2147483647 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では、ゾーンのデフォルト TTL が使用されます。明示的な値は 60 ～ 2147483647 秒である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 영역 기본 TTL을 사용합니다. 명시적 값은 60초에서 2147483647초 사이여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie używa domyślnego TTL strefy. Jawne wartości muszą mieścić się w przedziale od 60 do 2147483647 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa o TTL padrão da zona. Os valores explícitos devem estar entre 60 e 2147483647 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, bölge varsayılan TTL'sini kullanır. Açık değerler 60 ile 2147483647 saniye arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично використовує стандартний TTL зони. Явні значення мають бути від 60 до 2147483647 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động sử dụng TTL mặc định của vùng. Giá trị rõ ràng phải nằm trong khoảng từ 60 đến 2147483647 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动使用区域默认 TTL。显式值必须介于 60 到 2147483647 秒之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動使用區域預設 TTL。顯式值必須介於 60 到 2147483647 秒之間。"
          }
        }
      }
    },
    "Azure DNS applies one TTL to an entire RRset, from 1 through 2147483647 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS wendet eine TTL auf einen gesamten RRset an, von 1 bis 2147483647 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS aplica un TTL a un RRset completo, desde 1 hasta 2147483647 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS applique une durée de vie à un RRset entier, de 1 à 2 147 483 647 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS 1 से 2147483647 सेकंड तक संपूर्ण RRset पर एक TTL लागू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS menerapkan satu TTL ke seluruh RRset, dari 1 hingga 2147483647 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS は、1 ～ 2147483647 秒の 1 つの TTL を RRset 全体に適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS는 1초부터 2147483647초까지 전체 RRset에 하나의 TTL을 적용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS stosuje jeden czas TTL do całego zestawu RR, od 1 do 2147483647 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DNS do Azure aplica um TTL a um RRset inteiro, de 1 a 2147483647 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS, 1 ile 2147483647 saniye arasında bir RRset'in tamamına bir TTL uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS застосовує один TTL до всього RRset від 1 до 2147483647 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS áp dụng một TTL cho toàn bộ tập bản ghi tài nguyên, từ 1 đến 2147483647 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS 将一个 TTL 应用到整个 RRset，从 1 秒到 2147483647 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure DNS 將一個 TTL 套用到整個 RRset，從 1 秒到 2147483647 秒。"
          }
        }
      }
    },
