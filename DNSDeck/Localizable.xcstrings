    "Required only when creating a public DNS zone. Existing zones retain their own resource group.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur erforderlich, wenn eine öffentliche DNS-Zone erstellt wird. Vorhandene Zonen behalten ihre eigene Ressourcengruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requerido solo al crear una zona DNS pública. Las zonas existentes conservan su propio grupo de recursos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis uniquement lors de la création d'une zone DNS publique. Les zones existantes conservent leur propre groupe de ressources."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सार्वजनिक DNS ज़ोन बनाते समय आवश्यक है। मौजूदा क्षेत्र अपना स्वयं का संसाधन समूह बनाए रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan hanya saat membuat zona DNS publik. Zona yang ada mempertahankan kelompok sumber dayanya sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パブリック DNS ゾーンを作成する場合にのみ必要です。既存のゾーンは独自のリソース グループを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퍼블릭 DNS 영역을 생성할 때만 필요합니다. 기존 영역은 자체 리소스 그룹을 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane tylko w przypadku tworzenia publicznej strefy DNS. Istniejące strefy zachowują własną grupę zasobów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigatório somente ao criar uma zona DNS pública. As zonas existentes mantêm seu próprio grupo de recursos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca genel DNS bölgesi oluştururken gereklidir. Mevcut bölgeler kendi kaynak gruplarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необхідно лише під час створення публічної зони DNS. Існуючі зони зберігають власну ресурсну групу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bắt buộc khi tạo vùng DNS công cộng. Các vùng hiện tại giữ lại nhóm tài nguyên của riêng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在创建公共 DNS 区域时需要。现有区域保留自己的资源组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在建立公共 DNS 區域時需要。現有區域保留自己的資源組。"
          }
        }
      }
    },
