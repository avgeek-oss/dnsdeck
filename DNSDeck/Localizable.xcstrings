    "PowerDNS accepts non-negative 32-bit TTL values and replaces an entire RRset in one zone PATCH.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS akzeptiert nicht negative 32-Bit-TTL-Werte und ersetzt einen gesamten RRset in einem Zonen-PATCH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS acepta valores TTL de 32 bits no negativos y reemplaza un RRset completo en un PATCH de una zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS accepte les valeurs TTL 32 bits non négatives et remplace un RRset entier dans une zone PATCH."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS गैर-नकारात्मक 32-बिट TTL मान स्वीकार करता है और एक ज़ोन PATCH में संपूर्ण RRset को प्रतिस्थापित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS menerima nilai TTL 32-bit non-negatif dan menggantikan seluruh RRset dalam satu zona PATCH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS は、負でない 32 ビット TTL 値を受け入れ、1 つのゾーン PATCH 内の RRset 全体を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS는 음수가 아닌 32비트 TTL 값을 허용하고 하나의 영역 PATCH에서 전체 RRset를 대체합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS akceptuje nieujemne 32-bitowe wartości TTL i zastępuje cały zestaw RR w jednej strefie PATCH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS aceita valores TTL não negativos de 32 bits e substitui um RRset inteiro em uma zona PATCH."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS, negatif olmayan 32 bit TTL değerlerini kabul eder ve tek bir PATCH bölgesindeki tüm RRset'in yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS приймає невід’ємні 32-розрядні значення TTL і замінює весь RRset в одній зоні PATCH."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS chấp nhận các giá trị TTL 32 bit không âm và thay thế toàn bộ tập bản ghi tài nguyên trong một vùng PATCH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS 接受非负 32 位 TTL 值并替换一个区域 PATCH 中的整个 RRset。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerDNS 接受非負 32 位元 TTL 值並取代一個區域 PATCH 中的整個 RRset。"
          }
        }
      }
    },
